# .env.example — copy to .env (gitignored) and edit. Nothing here is
# required: every variable has a default, and the file as shipped is fully
# commented out. Docker compose reads .env automatically — it feeds
# compose's own ${...} substitution and, via compose.yaml's env_file
# stanza, passes straight into the container for the config document's
# ${VAR} references to resolve against. Bare docker/systemd runs just
# export what they need.

## The service bootstrap — read once at startup, not hot-reloaded.
## Every variable the process itself reads carries the OCFP_ prefix.
## Under compose the listen port stays 8090 behind the HOST_PORT mapping:
## change HOST_PORT below, not OCFP_PORT.

# Listen port (default 8090).
#OCFP_PORT=8090

# Config document path (empty = built-in direct runtime). compose.yaml pins
# this to the mounted /etc/ofp/config.yaml — environment overrides env_file.
#OCFP_CONFIG=/etc/ofp/config.yaml

# Hot-reload poll interval for the config document, milliseconds (default
# 1000).
#OCFP_CONFIG_POLL_MS=1000

# Drain window before force-close, milliseconds (default 55000).
#OCFP_SHUTDOWN_GRACE=55000

## docker compose.

# Host port the service is published on ("HOST_PORT:8090").
#HOST_PORT=30258

## Secrets the config document references. ${VAR} inside config.yaml
## resolves from the process environment at load time, and an unset
## reference is a load error — set each referenced variable here. These
## two are the example's own placeholders, never real credentials.

#OCFP_PROXY_USER=example-user
#OCFP_PROXY_PASSWORD=example-password
